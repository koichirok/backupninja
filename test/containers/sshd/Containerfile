FROM debian:sid

RUN apt-get -qq update && \
  DEBIAN_FRONTEND=noninteractive apt-get -yqq upgrade && \
  DEBIAN_FRONTEND=noninteractive \
    apt-get -yqq install --no-install-recommends openssh-server && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

RUN echo 'root:root' |chpasswd

RUN cat <<-EOF > /etc/ssh/sshd_config.d/backupserver.conf
	PasswordAuthentication yes
	PermitRootLogin yes
	Port 22
	Port 2222
	EOF

RUN useradd -m sshuser && \
  chage --lastday -1 sshuser && \
  rm -f /etc/shadow- && \
  mkdir /home/sshuser/.ssh

EXPOSE 22
EXPOSE 2222

CMD ["/usr/sbin/sshd", "-D", "-e"]
