# -*- mode: sh; sh-basic-offset: 3; indent-tabs-mode: nil; -*-
# vim: set filetype=sh sw=3 sts=3 expandtab autoindent:
#
# PostgreSQL handler script for backupninja
#

getconf backupdir /var/backups/postgres
getconf databases all
getconf compress yes
# format maps to pg_dump --format= option, old/default was plain
getconf format plain

# PostgreSQL role used to connect; empty keeps the role implied by PGSQLUSER
getconf dbusername

transport_init
localhost=`runcmd hostname`

# Make sure that the system to backup has the needed executables
if [ "$databases" == "all" ] || [ "$format" != "plain" ]; then
   PGSQLDUMPALL=$(transport_resolve "$PGSQLDUMPALL") || fatal "Can't find $PGSQLDUMPALL."
fi
if [ "$databases" != "all" ] || [ "$format" != "plain" ]; then
   PGSQLDUMP=$(transport_resolve "$PGSQLDUMP") || fatal "Can't find $PGSQLDUMP."
fi
if [ "$databases" == "all" ] && [ "$format" != "plain" ]; then
   PSQL=$(transport_resolve "$PSQL") || fatal "Can't find $PSQL."
fi
if [ "$compress" == "yes" ]; then
   transport_gzip_init
fi

# create backup dir
if ! runcmd test -d "$backupdir"; then
   debug "mkdir -p $backupdir"
   runcmd mkdir -p "$backupdir"
fi
runcmd test -d "$backupdir" || fatal "Backup directory '$backupdir' does not exist, and could not be created."

# PGSQLUSER is the system user running the dumps, not necessarily a database role
pguid=`runcmd getent passwd "$PGSQLUSER" | @AWK@ -F: '{print $3}'`
[ -n "$pguid" ] || fatal "No system user called $PGSQLUSER. Set PGSQLUSER to the system user owning PostgreSQL and dbusername to the database role."

# give backup dir the good uid and permissions
debug "chown $pguid $backupdir"
runcmd chown "$pguid" "$backupdir" || fatal "Can't change the owner of '$backupdir' to $PGSQLUSER."
debug "chmod 700 $backupdir"
runcmd chmod 700 "$backupdir" || fatal "Can't change the permissions of '$backupdir'."

connectopts=""
if [ -n "$dbusername" ]; then
   connectopts="-U $(shellquote "$dbusername")"
fi

# Run a shell command as the PostgreSQL system user in the target. /bin/sh is
# used so that minimal images without bash work; options come before the user
# name for BusyBox su.
function pgsql_su() {
   runcmd su -l -s /bin/sh -c "$1" "$PGSQLUSER"
}

# Dump with the shell command $2 into the file $3, described as $1. The output
# is written to a partial file which only replaces the previous backup when the
# dump (and compression) succeeded.
failed=0
function pgsql_dump() {
   local what="$1" dumpcmd="$2" target="$3"
   local script output code
   script=$(transport_dump_command "$dumpcmd" "$target" "$compress")
   debug "su -l -s /bin/sh -c \"$script\" $PGSQLUSER"
   [ ! $test ] || return 0

   output=`pgsql_su "$script" 2>&1`
   code=$?
   if [ "$code" == "0" ]; then
      debug "$output"
      info "Successfully finished dump of $what"
   else
      error "$output"
      error "Failed to dump $what"
      failed=1
   fi
}

# If we are using the custom (best) or tar pg_dump format, and
# dumping "all" databases, we will substitute "all" for a list
# of all non-template databases to avoid the use of pg_dumpall.
dumpglobals="no"
if [ "$databases" = "all" ] && [ "$format" != "plain" ]; then
   if [ -n "$dbusername" ]; then
      listcmd="$PSQL -At $connectopts -d postgres"
   else
      listcmd="$PSQL -AtU $PGSQLUSER"
   fi
   listcmd="$listcmd -c 'SELECT datname FROM pg_database WHERE NOT datistemplate'"
   debug "$listcmd"
   dblist=$(pgsql_su "$listcmd" 2>&1) || fatal "Can't list the databases: $dblist"
   databases=""
   for db in $dblist; do
      databases="$databases $db"
   done
   [ -n "$databases" ] || fatal "No databases found to back up."
   # Dump globals (pg_dumpall -g) for roles and tablespaces
   dumpglobals="yes"
fi

suffix=""
[ "$compress" != "yes" ] || suffix=".gz"

# if $databases = all, use pg_dumpall
if [ "$databases" == "all" ]; then
   pgsql_dump "pgsql cluster" "$PGSQLDUMPALL $connectopts" "$backupdir/${localhost}-all.sql$suffix"

# else use pg_dump on each specified database
else
   # If we're not doing plain format, database=all may now be database=list
   # so we track the database=all selection in dumpglobals which tells us
   # to also dump the roles and tablespaces via pg_dumpall -g
   if [ "$dumpglobals" = "yes" ]; then
      pgsql_dump "pgsql globals (roles and tablespaces)" "$PGSQLDUMPALL $connectopts -g" "$backupdir/globals.sql$suffix"
   fi
   for db in $databases; do
      dumpext="sql"
      if [ "$format" != "plain" ]; then
         dumpext="pg_dump"
      fi
      # To better support the backupninja global GZIP and rsync-friendly GZIP_OPTS
      # the custom archive format is told to disable compression. The plain format
      # is uncompressed by default and the tar format doesn't support pg_dump compression.
      disablecustomcompress=""
      if [ "$format" = "custom" ]; then
         disablecustomcompress="--compress=0"
      fi
      pgsql_dump "pgsql database ${db}" \
         "$PGSQLDUMP $connectopts --format=$format ${disablecustomcompress} $(shellquote "$db")" \
         "$backupdir/${db}.${dumpext}$suffix"
   done
fi

if [ "$failed" == 0 ]; then
   transport_finalize "$backupdir"
elif [ "$transport_name" != "local" ] && [ -n "$transport_host_backupdir" ]; then
   error "Not fetching backups to $transport_host_backupdir because a dump failed; previous backups were left unchanged."
fi
return 0
