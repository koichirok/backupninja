# -*- mode: sh; sh-basic-offset: 3; indent-tabs-mode: nil; -*-
# vim: set filetype=sh sw=3 sts=3 expandtab autoindent:
#
# mysql handler script for backupninja
#

getconf backupdir /var/backups/mysql
getconf databases all
getconf ignores
getconf nodata
getconf dbhost localhost
getconf hotcopy no
getconf sqldump no
getconf sqldumpoptions "--lock-tables --complete-insert --add-drop-table --quick --quote-names"
getconf compress yes

transport_init
failed=0
if [ "$sqldump" = yes ]; then
   MYSQL=$(transport_resolve "$MYSQL") || fatal "Can't find $MYSQL."
   MYSQLADMIN=$(transport_resolve "$MYSQLADMIN") || fatal "Can't find $MYSQLADMIN."
   MYSQLDUMP=$(transport_resolve "$MYSQLDUMP") || fatal "Can't find $MYSQLDUMP."
   [ "$compress" != yes ] || transport_gzip_init
fi

function mysql_su() {
   transport_run_as "$user" "$1"
}

# The OS user and database login are independent.
getconf user
configured_user="$user"
getconf dbusername
getconf dbpassword
getconf configfile
explicitconfig="$configfile"
configfile="${configfile:-/etc/mysql/debian.cnf}"
if [ -z "$user" ]; then
   user=$(runcmd id -un) || fatal "Can't determine the MySQL system user in the backup target."
fi
if [ "$hotcopy" = yes ]; then
   MYSQLHOTCOPY=$(transport_resolve "$MYSQLHOTCOPY") || fatal "Can't find $MYSQLHOTCOPY in the backup target."
   [ -z "$dbusername$dbpassword$explicitconfig" ] || \
      fatal "mysqlhotcopy does not support defaults-file authentication; use user with ~/.my.cnf, or disable hotcopy."
fi
[ -n "$dbusername" ] || [ -z "$dbpassword" ] || fatal "dbpassword requires dbusername."

ignore=''
for i in $ignores $nodata; do
   ignore="$ignore --ignore-table=$(shellquote "$i")"
done

# Create directories as the dump's OS user, not the database login or host user.
mysql_su "mkdir -p $(shellquote "$backupdir")" || fatal "Can't create backup directory '$backupdir'."
hotdir="$backupdir/hotcopy"
dumpdir="$backupdir/sqldump"
[ "$sqldump" = no ] || mysql_su "mkdir -p $(shellquote "$dumpdir")" || fatal "Can't create '$dumpdir'."
[ "$hotcopy" = no ] || mysql_su "mkdir -p $(shellquote "$hotdir")" || fatal "Can't create '$hotdir'."

#######################################################################
## AUTHENTICATION

defaultsfile=""
workcnf=""

function mysql_cleanup() {
   [ -n "$workcnf" ] || return 0
   mysql_su "rm -f $(shellquote "$workcnf")" || {
      error "Can't remove temporary MySQL credentials '$workcnf'."
      return 1
   }
   workcnf=""
}

# MySQL option files use double-quoted strings with backslash escapes.
function mysql_option_value() {
   local value="$1"
   value="${value//\\/\\\\}"
   value="${value//\"/\\\"}"
   value="${value//$'\n'/\\n}"
   value="${value//$'\r'/\\r}"
   value="${value//$'\t'/\\t}"
   printf '"%s"' "$value"
}

if [ -n "$dbusername" ]; then
   workcnf=$(mysql_su 'umask 077; mktemp /tmp/backupninja-mysql.XXXXXX') || \
      fatal "Can't create temporary MySQL credentials in the backup target."
   [ -n "$workcnf" ] || fatal "Empty temporary MySQL credentials path."
   trap 'mysql_cleanup || exit 1' EXIT
   trap 'exit 1' HUP INT TERM
   mysql_su "cat > $(shellquote "$workcnf")" <<EOF || fatal "Can't write temporary MySQL credentials."
[client]
host=$(mysql_option_value "$dbhost")
user=$(mysql_option_value "$dbusername")
password=$(mysql_option_value "$dbpassword")
EOF
   # All three SQL clients support this as their first option. Do not let
   # an existing ~/.my.cnf override the explicitly configured credentials.
   defaultsfile="--defaults-file=$workcnf"
elif [ -n "$configured_user" ]; then
   userpasswd=$(runcmd getent passwd "$user") || fatal "User $user not found in /etc/passwd"
   userhome=$(printf '%s\n' "$userpasswd" | @AWK@ -F: '{print $6}')
   [ -n "$userhome" ] || fatal "Can't find the home directory of $user."
   debug "User home set to: $userhome"
   mysql_su "test -r $(shellquote "$userhome/.my.cnf")" || fatal "Can't read config file in $userhome/.my.cnf"
   defaultsfile="--defaults-extra-file=$userhome/.my.cnf"
   debug "using $defaultsfile"
else
   defaultsfile="--defaults-extra-file=$configfile"
fi

#######################################################################
## HOT COPY

if [ "$hotcopy" = yes ]; then
   info "Initializing hotcopy method"
   if [ "$databases" = all ]; then
      execstr="$(shellquote "$MYSQLHOTCOPY") --quiet --allowold --regexp /.\*/./.\*/ $(shellquote "$hotdir")"
      debug "su $user -c \"$execstr\""
      if [ ! "$test" ]; then
         output=$(mysql_su "$execstr" 2>&1)
         code=$?
         if [ "$code" = 0 ]; then
            debug "$output"
            info "Successfully finished hotcopy of all mysql databases"
         else
            warning "$output"
            error "Failed to hotcopy all mysql databases"; failed=1
         fi
      fi
   else
      for db in $databases; do
         execstr="$(shellquote "$MYSQLHOTCOPY") --allowold $(shellquote "$db") $(shellquote "$hotdir")"
         debug "su $user -c \"$execstr\""
         if [ ! "$test" ]; then
            output=$(mysql_su "$execstr" 2>&1)
            code=$?
            if [ "$code" = 0 ]; then
               debug "$output"
               info "Successfully finished hotcopy of mysql database $db"
            else
               warning "$output"
               error "Failed to hotcopy mysql database $db"; failed=1
            fi
         fi
      done
   fi
fi

##########################################################################
## SQL DUMP

if [ "$sqldump" = yes ]; then
   info "Initializing SQL dump method"
   if [ "$databases" = all ]; then
      dblist=$(mysql_su "$(shellquote "$MYSQL") $(shellquote "$defaultsfile") -N -B -e 'show databases'") || \
         fatal "Authentication problem, maybe user/password is wrong or mysqld is not running?"
      databases=$(printf '%s\n' "$dblist" | sed 's/|//g;/\+----/d;/^\(information\|performance\)_schema$/d')
   fi

   for db in $databases; do
      # Sanitize database name
      db=$(echo "$db" | tr -d \'\;)
      DUMP_BASE="$(shellquote "$MYSQLDUMP") $(shellquote "$defaultsfile") $sqldumpoptions"
      DUMP="$DUMP_BASE $ignore $(shellquote "$db")"

      if echo "$nodata" | grep -E '(^|[[:space:]])'"$db\." >/dev/null; then
         DUMP_STRUCT="$DUMP_BASE --no-data $(shellquote "$db")"
         for qualified_table in $nodata; do
            table=$(expr match "$qualified_table" "$db\.\(.\+\)")
            DUMP_STRUCT="$DUMP_STRUCT $(shellquote "$table")"
         done
         DUMP="( $DUMP && $DUMP_STRUCT )"
      fi

      mysql_su "$(shellquote "$MYSQLADMIN") $(shellquote "$defaultsfile") ping >/dev/null 2>&1" || \
         fatal "mysqld doesn't appear to be running!"
      if [ "$compress" = yes ]; then
         target="$dumpdir/${db}.sql.gz"
      else
         target="$dumpdir/${db}.sql"
      fi
      execstr=$(transport_dump_command "$DUMP" "$target" "$compress")
      debug "su $user -c \"$execstr\""

      if [ ! "$test" ]; then
         output=$(mysql_su "$execstr" 2>&1)
         code=$?
         if [ "$code" = 0 ]; then
            debug "$output"
            info "Successfully finished dump of mysql database $db"
         else
            warning "$output"
            error "Failed to dump mysql databases $db"; failed=1
         fi
      fi
   done
fi

mysql_cleanup || fatal "Failed to clean up MySQL credentials."
trap - EXIT HUP INT TERM

if [ "$failed" = 0 ]; then
   transport_finalize "$backupdir"
elif [ "$transport_name" != local ] && [ -n "$transport_host_backupdir" ]; then
   error "Not fetching backups to $transport_host_backupdir because a backup failed; previous backups were left unchanged."
fi
return "$failed"
