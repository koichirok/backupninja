# -*- mode: sh; sh-basic-offset: 3; indent-tabs-mode: nil; -*-
# vim: set filetype=sh sw=3 sts=3 expandtab autoindent:
#
# mysql handler script for backupninja
#

getconf backupdir /var/backups/mysql
getconf databases all
getconf ignores
getconf nodata
getconf dbhost localhost
getconf hotcopy no
getconf sqldump no
getconf sqldumpoptions "--lock-tables --complete-insert --add-drop-table --quick --quote-names"
getconf compress yes

transport_init
failed=0
if [ "$sqldump" = yes ]; then
   MYSQL=$(transport_resolve "$MYSQL") || fatal "Can't find $MYSQL."
   MYSQLADMIN=$(transport_resolve "$MYSQLADMIN") || fatal "Can't find $MYSQLADMIN."
   MYSQLDUMP=$(transport_resolve "$MYSQLDUMP") || fatal "Can't find $MYSQLDUMP."
   [ "$compress" != yes ] || transport_gzip_init
fi

function mysql_su() {
   runcmd su -s /bin/sh -c "$1" "$user"
}

# authentication:
getconf user
getconf dbusername
getconf dbpassword
getconf configfile /etc/mysql/debian.cnf


## Prepare ignore part of the command
## This only works for mysqldump at the moment

ignore=''
for i in $ignores $nodata; do
   ignore="$ignore --ignore-table=$i"
done

# create backup dirs in the selected transport target
runcmd test -d "$backupdir" || runcmd mkdir -p "$backupdir"
runcmd test -d "$backupdir" || fatal "Backup directory '$backupdir'"
hotdir="$backupdir/hotcopy"
dumpdir="$backupdir/sqldump"

[ "$sqldump" == "no" ] || runcmd test -d "$dumpdir" || runcmd mkdir -p "$dumpdir"
[ "$hotcopy" == "no" ] || runcmd test -d "$hotdir" || runcmd mkdir -p "$hotdir"

#######################################################################
## AUTHENTICATION

#
# one of three authentication methods:
# 1. setting the user, so that /home/user/.my.cnf is used.
# 2. specifying the user and password in the handler config,
#    which generates a temporary .my.cnf in /root/.my.cnf
# 3. specify the config file with --defaults-extra-file
#    (this option DOESN'T WORK WITH MYSQLHOTCOPY)
#

# create .my.cnf
# only if dbusername and dbpassword specified.
# we create a tmp file because we don't want to
# specify the password on the command line.

defaultsfile=""

if [ -n "$dbusername" -a -n "$dbpassword" ]
then
   home=`runcmd getent passwd "root" | @AWK@ -F: '{print $6}'`

   runcmd test -d "$home" || fatal "Can't find root's home directory ($home)."

   mycnf="$home/.my.cnf"

   workcnf="$mycnf"

   if runcmd test -f "$workcnf"
   then
      # rename temporarily
      tmpcnf="$workcnf.disable"
      debug "mv $workcnf $tmpcnf"
      runcmd mv "$workcnf" "$tmpcnf"
   fi

   runcmd sh -c 'umask 077; cat > "$1"' sh "$workcnf" <<EOF
# auto generated backupninja mysql conf
[mysql]
host=$dbhost
user=$dbusername
password="$dbpassword"

[mysqldump]
host=$dbhost
user=$dbusername
password="$dbpassword"

[mysqlhotcopy]
host=$dbhost
user=$dbusername
password="$dbpassword"

[mysqladmin]
host=$dbhost
user=$dbusername
password="$dbpassword"
EOF
   defaultsfile="--defaults-extra-file=$mycnf"

# else, if a user is set use her .my.cnf
elif [ -n "$user" ]
then
   userset=true;

   userhome=`runcmd getent passwd "$user" | @AWK@ -F: '{print $6}'`
   if [ $? -eq 2 ]
   then
      fatal "User $user not found in /etc/passwd"
   fi
   debug "User home set to: $userhome"
   runcmd test -f "$userhome/.my.cnf" || fatal "Can't find config file in $userhome/.my.cnf"

   defaultsfile="--defaults-extra-file=$userhome/.my.cnf"
   debug "using $defaultsfile"
   # otherwise use $configfile
else
   user=root
   defaultsfile="--defaults-extra-file=$configfile"
fi

#######################################################################
## HOT COPY

if [ "$hotcopy" == "yes" ]
then
   info "Initializing hotcopy method"
   if [ "$databases" == "all" ]
   then
      execstr="$MYSQLHOTCOPY --quiet --allowold --regexp /.\*/./.\*/ $(shellquote "$hotdir")"
      debug "su $user -c \"$execstr\""
      if [ ! $test ]
      then
         output=`mysql_su "$execstr" 2>&1`
         code=$?
         if [ "$code" == "0" ]
         then
            debug "$output"
            info "Successfully finished hotcopy of all mysql databases"
         else
            warning "$output"
            error "Failed to hotcopy all mysql databases"; failed=1
         fi
      fi
   else
      for db in $databases
      do
         execstr="$MYSQLHOTCOPY --allowold $(shellquote "$db") $(shellquote "$hotdir")"
         debug 'su $user -c \"$execstr\"'
         if [ ! $test ]
         then
            output=`mysql_su "$execstr" 2>&1`
            code=$?
            if [ "$code" == "0" ]
            then
               debug "$output"
               info "Successfully finished hotcopy of mysql database $db"
            else
               warning "$output"
               error "Failed to hotcopy mysql database $db"; failed=1
            fi
         fi
      done
   fi
fi

##########################################################################
## SQL DUMP

if [ "$sqldump" == "yes" ]
then
   info "Initializing SQL dump method"
   if [ "$databases" == "all" ]
   then
      dblist=$(mysql_su "$MYSQL $(shellquote "$defaultsfile") -N -B -e 'show databases'") || \
         fatal "Authentication problem, maybe user/password is wrong or mysqld is not running?"
      databases=$(printf '%s\n' "$dblist" | sed 's/|//g;/\+----/d;/^\(information\|performance\)_schema$/d')
   fi

   for db in $databases
   do
      # Sanitize database name
      db=$(echo $db | tr -d \'\;)

      DUMP_BASE="$MYSQLDUMP $(shellquote "$defaultsfile") $sqldumpoptions"

      # Dumping structure and data
      DUMP="$DUMP_BASE $ignore $(shellquote "$db")"

      # If requested, dump only the table structure for this database
      if echo "$nodata" | grep -E '(^|[[:space:]])'"$db\." >/dev/null
      then
         # Get the structure of the tables, without data
         DUMP_STRUCT="$DUMP_BASE --no-data $(shellquote "$db")"
         for qualified_table in $nodata
         do
            table=$( expr match "$qualified_table" "$db\.\(.\+\)" )
            DUMP_STRUCT="$DUMP_STRUCT $(shellquote "$table")"
         done
         DUMP="( $DUMP && $DUMP_STRUCT )"
      fi

      # Test to make sure mysqld is running, if it is not sqldump will not work
      mysql_su "$MYSQLADMIN $(shellquote "$defaultsfile") ping 2>&1 >/dev/null"
      if [ $? -ne 0 ]; then
         fatal "mysqld doesn't appear to be running!"
      fi
      if [ "$compress" == "yes" ]; then
         target="$dumpdir/${db}.sql.gz"
      else
         target="$dumpdir/${db}.sql"
      fi
      execstr=$(transport_dump_command "$DUMP" "$target" "$compress")
      debug "su $user -c \"$execstr\""

      if [ ! $test ]
      then
         output=`mysql_su "$execstr" 2>&1`
         code=$?
         if [ "$code" == "0" ]
         then
            debug "$output"
            info "Successfully finished dump of mysql database $db"
         else
            warning "$output"
            error "Failed to dump mysql databases $db"; failed=1
         fi
      fi
   done
fi

# clean up tmp config file
if [ "$dbusername" != "" -a "$dbpassword" != "" ]
then
   ## clean up tmp config file
   debug "rm $workcnf"
   runcmd rm "$workcnf"
   if [ -n "$tmpcnf" ] && runcmd test -f "$tmpcnf"
   then
      debug "mv $tmpcnf $workcnf"
      runcmd mv "$tmpcnf" "$workcnf"
   fi
fi

if [ "$failed" == 0 ]; then
   transport_finalize "$backupdir"
elif [ "$transport_name" != "local" ] && [ -n "$transport_host_backupdir" ]; then
   error "Not fetching backups to $transport_host_backupdir because a backup failed; previous backups were left unchanged."
fi
return 0
