#!@BASH@
# -*- mode: sh; sh-basic-offset: 3; indent-tabs-mode: nil; -*-
# vim: set filetype=sh sw=3 sts=3 expandtab autoindent:

# This file contains functions shared between ninjahelper and backupninja.

#####################################################
## MISC FUNCTIONS

#
# create a temporary file in a secure way.
#
function maketemp() {
   local tempfile=`mktemp /tmp/$1.XXXXXXXX`
   echo $tempfile
}

#
# compare version numbers.
# returns 0 if equal, 1 if $1>$2, and 2 if $1<$2
#

function compare_versions() {
   if [[ "$1" == "$2" ]]; then
      return 0
   fi
   local IFS=.
   local i version_1=($1) version_2=($2)
   for ((i=${#version_1[@]}; i<${#version_2[@]}; i++)); do
      version_1[i]=0
   done
   for ((i=0; i<${#version_1[@]}; i++)); do
      if [[ -z ${version_2[i]} ]]; then
         version_2[i]=0
      fi
      if ((10#${version_1[i]} > 10#${version_2[i]})); then
         return 1
      fi
      if ((10#${version_1[i]} < 10#${version_2[i]})); then
         return 2
      fi
   done
   return 0
}

#
# compare version numbers: >=
#

function version_ge() {
   compare_versions "$1" "$2"
   comp=$?
   [ $comp -eq 0 ] || [ $comp -eq 1 ]
}

#####################################################
## CONFIG-FILE RELATED FUNCTIONS

function setfile() {
   CURRENT_CONF_FILE=$1
}

function setsection() {
   CURRENT_SECTION=$1
}

#
# sets a global var with name equal to $1
# to the value of the configuration parameter $1
# $2 is the default.
#
function getconf() {
   CURRENT_PARAM=$1
   ret=`@AWK@ -f $libdirectory/parseini S=$CURRENT_SECTION P=$CURRENT_PARAM $CURRENT_CONF_FILE`
   # if nothing is returned, set the default
   if [ "$ret" == "" -a "$2" != "" ]; then
      ret="$2"
   fi

   # replace * with %, so that it is not globbed.
   ret="${ret//\\*/__star__}"

   # this is weird, but single quotes are needed to
   # allow for returned values with spaces. $ret is still expanded
   # because it is in an 'eval' statement.
   eval $1='$ret'
}

#####################################################
## COMMAND TRANSPORT

# Reject unsupported transports before a host-only handler has any side effects.
function transport_check_handler() {
   local handler="$1" transport previous_section="$CURRENT_SECTION"
   setsection transport
   getconf transport local
   setsection "$previous_section"
   case "$handler" in
      mysql|pgsql|gitlab) return 0 ;;
   esac
   [ "$transport" = local ] || fatal "Handler '$handler' does not support command transport '$transport'; refusing to run on the host."
}

# Initialize command execution for the action's optional [transport] section.
# Handlers use runcmd instead of invoking commands directly.
function transport_init() {
   local previous_section="$CURRENT_SECTION"
   local transport container service projectdir user workdir hostbackupdir
   local docker podman docker_compose environment value services

   setsection transport
   getconf transport local
   getconf container || true
   getconf service || true
   getconf projectdir || true
   getconf user || true
   getconf workdir || true
   getconf hostbackupdir || true
   getconf docker docker || true
   getconf podman podman || true
   getconf docker_compose || true
   getconf environment || true
   setsection "$previous_section"

   transport_name="$transport"
   transport_host_workdir=""
   transport_host_backupdir="$hostbackupdir"
   transport_cmd=()

   case "$transport_name" in
      local)
         ;;
      docker|podman)
         [ -n "$container" ] || fatal "The '$transport_name' transport requires 'container' in [transport]."
         if [ "$transport_name" == "docker" ]; then
            command -v "$docker" >/dev/null 2>&1 || fatal "Can't find Docker executable '$docker'."
            transport_cmd=("$docker" exec -i)
         else
            command -v "$podman" >/dev/null 2>&1 || fatal "Can't find Podman executable '$podman'."
            transport_cmd=("$podman" exec -i)
         fi
         [ -z "$user" ] || transport_cmd+=(--user "$user")
         [ -z "$workdir" ] || transport_cmd+=(--workdir "$workdir")
         while IFS= read -r value; do
            [ -z "$value" ] || transport_cmd+=(--env "$value")
         done <<< "$environment"
         transport_cmd+=("$container")
         ;;
      docker-compose)
         [ -n "$projectdir" ] || fatal "The 'docker-compose' transport requires 'projectdir' in [transport]."
         [ -d "$projectdir" ] || fatal "Docker Compose project directory '$projectdir' does not exist."
         [ -n "$service" ] || fatal "The 'docker-compose' transport requires 'service' in [transport]."
         if [ -n "$docker_compose" ]; then
            command -v "$docker_compose" >/dev/null 2>&1 || fatal "Can't find Docker Compose executable '$docker_compose'."
            transport_compose_cmd=("$docker_compose")
         else
            command -v "$docker" >/dev/null 2>&1 || fatal "Can't find Docker executable '$docker'."
            "$docker" compose version >/dev/null 2>&1 || fatal "Docker Compose is not available through '$docker compose'."
            transport_compose_cmd=("$docker" compose)
         fi
         services=$(cd "$projectdir" && "${transport_compose_cmd[@]}" config --services) || \
            fatal "Cannot list services in Docker Compose project '$projectdir'."
         grep -Fxq -- "$service" <<< "$services" || \
            fatal "Service '$service' does not exist in Docker Compose project '$projectdir'."
         transport_cmd=("${transport_compose_cmd[@]}" exec -T)
         [ -z "$user" ] || transport_cmd+=(--user "$user")
         [ -z "$workdir" ] || transport_cmd+=(--workdir "$workdir")
         while IFS= read -r value; do
            [ -z "$value" ] || transport_cmd+=(--env "$value")
         done <<< "$environment"
         transport_cmd+=("$service")
         transport_host_workdir="$projectdir"
         ;;
      *)
         fatal "Unsupported transport '$transport_name'."
         ;;
   esac
}

function runcmd() {
   if [ "$transport_name" == "local" ]; then
      "$@"
   elif [ -n "$transport_host_workdir" ]; then
      (cd "$transport_host_workdir" && "${transport_cmd[@]}" "$@")
   else
      "${transport_cmd[@]}" "$@"
   fi
}

# Avoid su when exec already selected the required system user. Container
# commands must retain the transport's environment and working directory.
function transport_run_as() {
   local user="$1" script="$2" login="${3:-}"
   runcmd sh -c '
      wanted=$(id -u "$1") || exit
      current=$(id -u) || exit
      if [ "$current" = "$wanted" ]; then
         exec /bin/sh -c "$2"
      fi
      if [ "$current" != 0 ]; then
         echo "Cannot run commands as $1: transport user is not root." >&2
         exit 1
      fi
      if [ "$3" = login ]; then
         exec su -l -s /bin/sh -c "$2" "$1"
      fi
      exec su -s /bin/sh -c "$2" "$1"
   ' sh "$user" "$script" "$login"
}

# Quote a value for safe use in a POSIX shell command string.
function shellquote() {
   local q="'"
   printf "'%s'" "${1//$q/$q\\$q$q}"
}

# Resolve executable paths in the target, not on the backupninja host.
function transport_resolve() {
   local resolved
   resolved=$(runcmd sh -c 'p=$(command -v "$1") && [ -x "$p" ] && printf "%s\n" "$p"' sh "$1" 2>/dev/null) || \
   resolved=$(runcmd sh -c 'p=$(command -v "$1") && [ -x "$p" ] && printf "%s\n" "$p"' sh "${1##*/}" 2>/dev/null) || \
      return 1
   printf '%s\n' "$resolved"
}

function transport_gzip_init() {
   GZIP=$(transport_resolve "$GZIP") || fatal "Can't find $GZIP in the backup target."
   if [ -n "$GZIP_OPTS" ] && ! runcmd sh -c "$(shellquote "$GZIP") $GZIP_OPTS" </dev/null >/dev/null 2>&1; then
      warning "$GZIP does not support the options '$GZIP_OPTS', compressing without them."
      GZIP_OPTS=""
   fi
}

# Build a POSIX sh script that preserves both pipeline statuses and installs
# output only on success. The producer must itself propagate command failures.
function transport_dump_command() {
   local dumpcmd="$1" target="$2" compress="$3"
   local qtemplate qtarget script directory
   directory="${target%/*}"
   [ "$directory" != "$target" ] || directory=.
   qtemplate=$(shellquote "$directory/.${target##*/}.partial.XXXXXX")
   qtarget=$(shellquote "$target")
   if [ "$compress" = yes ]; then
      script="rc=\$( { { $dumpcmd; echo \$? >&3; } | $(shellquote "$GZIP") $GZIP_OPTS > \"\$partial\"; } 3>&1 ) && [ \"\$rc\" = 0 ]"
   else
      script="( $dumpcmd ) > \"\$partial\""
   fi
   printf '%s\n' "umask 077
partial=\$(mktemp $qtemplate) || exit 1
trap 'rm -f \"\$partial\" || exit 1' 0
trap 'exit 1' 1 2 15
if $script; then
   [ ! -d $qtarget ] && mv -f \"\$partial\" $qtarget
else
   exit 1
fi"
}

# Copy the contents of remote_path in the transport target to hostbackupdir.
# Call this only after the backup succeeded. The files are streamed through
# runcmd into a staging directory first and are moved into place only after
# the whole transfer succeeded, so a failed transfer leaves the previous
# backups untouched.
function transport_finalize() {
   local remote_path="$1"
   local staging file parent
   local -a status

   [ "$transport_name" != "local" ] || return 0
   [ -n "$transport_host_backupdir" ] || return 0
   [ -n "$remote_path" ] || fatal "Cannot fetch an empty backup path."
   if [ $test ]; then
      debug "test mode: not fetching $remote_path to $transport_host_backupdir"
      return 0
   fi

   mkdir -p "$transport_host_backupdir" || fatal "Cannot create host backup directory '$transport_host_backupdir'."
   staging=$(mktemp -d "$transport_host_backupdir/.backupninja-fetch.XXXXXX") || \
      fatal "Cannot create a staging directory in '$transport_host_backupdir'."

   debug "fetching $remote_path from $transport_name target to $transport_host_backupdir"
   runcmd tar -cf - -C "$remote_path" . | \
      tar -xf - -C "$staging" --no-same-owner --no-same-permissions
   status=("${PIPESTATUS[@]}")
   if [ "${status[0]}" != 0 ] || [ "${status[1]}" != 0 ]; then
      rm -rf "$staging"
      fatal "Failed to fetch '$remote_path' from the $transport_name target into '$transport_host_backupdir'; previous backups were left unchanged."
   fi

   # Validate destinations before replacing any files. A host-side symlink
   # must not redirect installation outside the requested backup directory.
   while IFS= read -r -d '' file; do
      file="${file#./}"
      [ -f "$staging/$file" ] && [ ! -L "$staging/$file" ] || continue
      parent=$(dirname "$file")
      while [ "$parent" != . ]; do
         if [ -L "$transport_host_backupdir/$parent" ] || \
            { [ -e "$transport_host_backupdir/$parent" ] && [ ! -d "$transport_host_backupdir/$parent" ]; }; then
            rm -rf "$staging"
            fatal "Unsafe host backup parent '$parent'; previous backups were left unchanged."
         fi
         parent=$(dirname "$parent")
      done
      if [ -d "$transport_host_backupdir/$file" ]; then
         rm -rf "$staging"
         fatal "Host backup destination '$file' is a directory; previous backups were left unchanged."
      fi
   done < <(cd "$staging" && find . ! -type d -print0)

   # Only regular files are installed; links from the target are not trusted.
   while IFS= read -r -d '' file; do
      file="${file#./}"
      if [ ! -f "$staging/$file" ] || [ -L "$staging/$file" ]; then
         warning "Not installing '$file' from the $transport_name target: not a regular file."
         continue
      fi
      mkdir -p "$transport_host_backupdir/$(dirname "$file")" && \
         mv -fT "$staging/$file" "$transport_host_backupdir/$file" || {
            rm -rf "$staging"
            fatal "Failed to install '$file' into '$transport_host_backupdir'."
         }
   done < <(cd "$staging" && find . ! -type d -print0)
   rm -rf "$staging" || fatal "Cannot remove backup staging directory '$staging'."
}
