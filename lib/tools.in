#!@BASH@
# -*- mode: sh; sh-basic-offset: 3; indent-tabs-mode: nil; -*-
# vim: set filetype=sh sw=3 sts=3 expandtab autoindent:

# This file contains functions shared between ninjahelper and backupninja.

#####################################################
## MISC FUNCTIONS

#
# create a temporary file in a secure way.
#
function maketemp() {
   local tempfile=`mktemp /tmp/$1.XXXXXXXX`
   echo $tempfile
}

#
# compare version numbers.
# returns 0 if equal, 1 if $1>$2, and 2 if $1<$2
#

function compare_versions() {
   if [[ "$1" == "$2" ]]; then
      return 0
   fi
   local IFS=.
   local i version_1=($1) version_2=($2)
   for ((i=${#version_1[@]}; i<${#version_2[@]}; i++)); do
      version_1[i]=0
   done
   for ((i=0; i<${#version_1[@]}; i++)); do
      if [[ -z ${version_2[i]} ]]; then
         version_2[i]=0
      fi
      if ((10#${version_1[i]} > 10#${version_2[i]})); then
         return 1
      fi
      if ((10#${version_1[i]} < 10#${version_2[i]})); then
         return 2
      fi
   done
   return 0
}

#
# compare version numbers: >=
#

function version_ge() {
   compare_versions "$1" "$2"
   comp=$?
   [ $comp -eq 0 ] || [ $comp -eq 1 ]
}

#####################################################
## CONFIG-FILE RELATED FUNCTIONS

function setfile() {
   CURRENT_CONF_FILE=$1
}

function setsection() {
   CURRENT_SECTION=$1
}

#
# sets a global var with name equal to $1
# to the value of the configuration parameter $1
# $2 is the default.
#
function getconf() {
   CURRENT_PARAM=$1
   ret=`@AWK@ -f $libdirectory/parseini S=$CURRENT_SECTION P=$CURRENT_PARAM $CURRENT_CONF_FILE`
   # if nothing is returned, set the default
   if [ "$ret" == "" -a "$2" != "" ]; then
      ret="$2"
   fi

   # replace * with %, so that it is not globbed.
   ret="${ret//\\*/__star__}"

   # this is weird, but single quotes are needed to
   # allow for returned values with spaces. $ret is still expanded
   # because it is in an 'eval' statement.
   eval $1='$ret'
}

#####################################################
## COMMAND TRANSPORT

# Initialize command execution for the action's optional [transport] section.
# Handlers use runcmd instead of invoking commands directly.
function transport_init() {
   local previous_section="$CURRENT_SECTION"
   local transport container service projectdir user workdir hostbackupdir
   local docker podman docker_compose environment value

   setsection transport
   getconf transport local
   getconf container || true
   getconf service || true
   getconf projectdir || true
   getconf user || true
   getconf workdir || true
   getconf hostbackupdir || true
   getconf docker docker || true
   getconf podman podman || true
   getconf docker_compose || true
   getconf environment || true
   setsection "$previous_section"

   transport_name="$transport"
   transport_host_workdir=""
   transport_host_backupdir="$hostbackupdir"
   transport_cmd=()
   transport_copy_cmd=()

   case "$transport_name" in
      local)
         ;;
      docker|podman)
         [ -n "$container" ] || fatal "The '$transport_name' transport requires 'container' in [transport]."
         if [ "$transport_name" == "docker" ]; then
            command -v "$docker" >/dev/null 2>&1 || fatal "Can't find Docker executable '$docker'."
            transport_cmd=("$docker" exec -i)
            transport_copy_cmd=("$docker" cp)
         else
            command -v "$podman" >/dev/null 2>&1 || fatal "Can't find Podman executable '$podman'."
            transport_cmd=("$podman" exec -i)
            transport_copy_cmd=("$podman" cp)
         fi
         [ -z "$user" ] || transport_cmd+=(--user "$user")
         [ -z "$workdir" ] || transport_cmd+=(--workdir "$workdir")
         while IFS= read -r value; do
            [ -z "$value" ] || transport_cmd+=(--env "$value")
         done <<< "$environment"
         transport_cmd+=("$container")
         transport_container="$container"
         ;;
      docker-compose)
         [ -n "$projectdir" ] || fatal "The 'docker-compose' transport requires 'projectdir' in [transport]."
         [ -d "$projectdir" ] || fatal "Docker Compose project directory '$projectdir' does not exist."
         [ -n "$service" ] || fatal "The 'docker-compose' transport requires 'service' in [transport]."
         if [ -n "$docker_compose" ]; then
            command -v "$docker_compose" >/dev/null 2>&1 || fatal "Can't find Docker Compose executable '$docker_compose'."
            transport_compose_cmd=("$docker_compose")
         else
            command -v "$docker" >/dev/null 2>&1 || fatal "Can't find Docker executable '$docker'."
            "$docker" compose version >/dev/null 2>&1 || fatal "Docker Compose is not available through '$docker compose'."
            transport_compose_cmd=("$docker" compose)
         fi
         (cd "$projectdir" && "${transport_compose_cmd[@]}" config --services) | grep -Fxq -- "$service" || \
            fatal "Service '$service' does not exist in Docker Compose project '$projectdir'."
         transport_cmd=("${transport_compose_cmd[@]}" exec -T)
         [ -z "$user" ] || transport_cmd+=(--user "$user")
         [ -z "$workdir" ] || transport_cmd+=(--workdir "$workdir")
         while IFS= read -r value; do
            [ -z "$value" ] || transport_cmd+=(--env "$value")
         done <<< "$environment"
         transport_cmd+=("$service")
         transport_copy_cmd=("$docker" cp)
         transport_host_workdir="$projectdir"
         transport_service="$service"
         ;;
      *)
         fatal "Unsupported transport '$transport_name'."
         ;;
   esac
}

function runcmd() {
   if [ "$transport_name" == "local" ]; then
      "$@"
   elif [ -n "$transport_host_workdir" ]; then
      (cd "$transport_host_workdir" && "${transport_cmd[@]}" "$@")
   else
      "${transport_cmd[@]}" "$@"
   fi
}

function transport_finalize() {
   local remote_path="$1"
   local container_id

   [ "$transport_name" != "local" ] || return 0
   [ -n "$transport_host_backupdir" ] || return 0
   [ -n "$remote_path" ] || fatal "Cannot fetch an empty backup path."

   mkdir -p "$transport_host_backupdir" || fatal "Cannot create host backup directory '$transport_host_backupdir'."
   if [ "$transport_name" == "docker-compose" ]; then
      container_id=$(cd "$transport_host_workdir" && "${transport_compose_cmd[@]}" ps -q "$transport_service")
      [ -n "$container_id" ] || fatal "Cannot find the container for Docker Compose service '$transport_service'."
   else
      container_id="$transport_container"
   fi

   debug "fetching $remote_path from $transport_name target to $transport_host_backupdir"
   "${transport_copy_cmd[@]}" "$container_id:${remote_path%/}/." "$transport_host_backupdir/" || \
      fatal "Failed to fetch '$remote_path' into '$transport_host_backupdir'."
}
